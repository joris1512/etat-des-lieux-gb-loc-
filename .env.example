# Copier en `.env` et renseigner la vraie clé.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GB_MODEL=claude-opus-4-8

# --- Hébergement / sécurité ---
# Authentification activée dès que GB_PASSWORD OU GB_PASSWORD_HASH est défini.
GB_USER=gb
# Option simple (dev) : mot de passe en clair.
GB_PASSWORD=changez-moi
# Option recommandée (prod) : empreinte hachée, mot de passe jamais stocké en clair.
#   générez-la avec :  python scripts/hash_password.py
# GB_PASSWORD_HASH=pbkdf2_sha256$200000$...
# Purge auto des fichiers générés (heures ; 0 = désactivée) :
GB_RETENTION_HEURES=24
# Écoute réseau du service :
GB_HOST=0.0.0.0
GB_PORT=8000
