# Copier en `.env` et renseigner la vraie clé.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GB_MODEL=claude-opus-4-8

# --- Hébergement / sécurité ---
# Authentification activée dès que GB_PASSWORD OU GB_PASSWORD_HASH est défini.
GB_USER=gb
# Option recommandée : empreinte hachée, mot de passe jamais stocké en clair.
#   générez-la avec :  python scripts/hash_password.py
GB_PASSWORD_HASH=
# (option dev uniquement : GB_PASSWORD=... en clair)
# Purge auto des fichiers générés (heures ; 0 = désactivée). 8760 = ~1 an,
# à garder ALIGNÉ avec le registre RGPD du README :
GB_RETENTION_HEURES=8760
# Écoute réseau : 127.0.0.1 = ce poste uniquement (recommandé).
# 0.0.0.0 (tout le LAN) uniquement derrière un proxy HTTPS + information des personnes.
GB_HOST=127.0.0.1
GB_PORT=8000
